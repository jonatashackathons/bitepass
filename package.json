{
  "name": "bitepass",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:mobile": "playwright test tests/e2e/mobile-view.spec.ts",
    "test:pitch": "playwright test --config=playwright.demo.config.ts tests/e2e/pitch-demo.spec.ts",
    "test:pitch:labeled": "playwright test --config=playwright.demo.config.ts tests/e2e/pitch-30s-labeled.spec.ts",
    "openapi:generate": "node --experimental-strip-types scripts/generate-openapi.mjs",
    "check:links": "node scripts/check-links.js",
    "check:docs": "node scripts/check-docs-drift.mjs",
    "ops:smoke": "node scripts/ops/post-deploy-smoke.mjs",
    "ops:replay-webhook": "node scripts/ops/replay-webhook.mjs",
    "validate": "npm run typecheck && npm run lint && npm run check:links && npm run check:docs && npm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "dx:up": "node scripts/dx-preflight.js && docker compose up -d --wait && npm run db:migrate:prod && npm run db:seed && npm run dev",
    "dx:down": "docker compose down"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@prisma/client": "^6.19.3",
    "ag-grid-community": "^33.1.1",
    "ag-grid-react": "^33.1.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.1.7",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
