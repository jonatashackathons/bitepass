# Bypass.ai (Bitepass) Environment Variables
# If omitted or left empty, the application automatically uses transparent local mock simulation
# for offline judge evaluation.

# Google Gemini API Key (Gemini 4 Argon)
GEMINI_API_KEY=

# PayPal Sandbox Credentials (Orders v2 API)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
