# BitePass Environment Variables
# Copy to .env.local for local development (zero credentials required for offline mock mode)

APP_ENV=local
BITEPASS_MOCK_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
STORAGE_DRIVER=memory

# Gemini AI Reasoning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon

# PayPal Orders v2 + Vault v3 + Multiparty Escrow
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PARTNER_MERCHANT_ID=

# Auth, KDS & Geofence Attestation Secrets
BITEPASS_SESSION_SECRET=dev-session-secret-change-in-production-32chars
MERCHANT_KDS_TOKEN=dev-merchant-kds-token
SANDBOX_ADMIN_TOKEN=dev-sandbox-admin-token
GEOFENCE_HMAC_SECRET=dev-geofence-ble-hmac-secret
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL (Prisma + PgBouncer/Supavisor) & Redis
DATABASE_URL=postgresql://bitepass:bitepass_dev_password@127.0.0.1:54329/bitepass?schema=public
DIRECT_URL=postgresql://bitepass:bitepass_dev_password@127.0.0.1:54329/bitepass?schema=public
REDIS_URL=redis://127.0.0.1:63799
BITEPASS_PG_PORT=54329
BITEPASS_REDIS_PORT=63799
